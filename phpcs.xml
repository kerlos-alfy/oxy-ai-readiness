<?xml version="1.0"?>
<ruleset name="OxyAIReadiness">
    <description>Coding standard for Oxy AI Readiness (docs/28-Testing-Strategy.md, docs/29-Developer-Guide.md).

    Hybrid standard: this project is modern OOP PHP (PSR-4 autoloading, typed
    and readonly properties, camelCase methods) rather than classic
    procedural WordPress plugin code, per docs/29-Developer-Guide.md
    ("PSR-12 where compatible"; Naming Conventions: Classes PascalCase,
    Methods camelCase). PSR-12 governs formatting and naming. WordPress
    Coding Standards is applied narrowly, for the security/API-usage/i18n
    sniffs that matter regardless of code style — not for its procedural
    formatting rules (tabs, snake_case variables, K&amp;R braces), which
    would conflict with PSR-12 and are intentionally not included.
    </description>

    <file>app</file>
    <file>tests</file>
    <file>routes</file>
    <file>oxy-ai-readiness.php</file>
    <file>uninstall.php</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- PHPUnit descriptive test methods intentionally use snake_case. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- WordPress core stubs mirror the real global API. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.Security">
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>oxy-ai-readiness\.php$</exclude-pattern>
    </rule>

    <!--
    Alpha.5 signing code reads local binary archives, signatures, and PEM files.
    These are not remote URL reads; wp_remote_get() is therefore inapplicable.
    Temporary updater downloads are also deleted directly after verification.
    Test fixtures intentionally mutate/delete local temp files to test tampering.
    Exceptions are limited to those signing/package test files only.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
        <exclude-pattern>app/Services/UpdaterService\.php$</exclude-pattern>
        <exclude-pattern>tests/Integration/PackagingTest\.php$</exclude-pattern>
        <exclude-pattern>tests/Unit/Services/UpdaterServiceTest\.php$</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions.unlink_unlink">
        <exclude-pattern>app/Services/UpdaterService\.php$</exclude-pattern>
        <exclude-pattern>tests/Unit/Services/UpdaterServiceTest\.php$</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents">
        <exclude-pattern>tests/Unit/Services/UpdaterServiceTest\.php$</exclude-pattern>
    </rule>

    <!--
    Long PHPStan array-shape annotations and deterministic fixture assertions are
    kept intact in the new updater/license files because splitting their type
    grammar would reduce readability without changing runtime behavior.
    -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>app/Services/LicenseService\.php$</exclude-pattern>
        <exclude-pattern>app/Services/UpdaterService\.php$</exclude-pattern>
        <exclude-pattern>tests/Integration/PackagingTest\.php$</exclude-pattern>
        <exclude-pattern>tests/Unit/Services/UpdaterServiceTest\.php$</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPressVIPMinimum.Security"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="oxy-ai-readiness"/>
            </property>
        </properties>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
